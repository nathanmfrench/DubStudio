{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "typeRoots": [
      "./node_modules/@types",
      "./lambda/node_modules/@types"
    ],
    "outDir": "./dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@lambda/*": ["./lambda/src/*"]
    }
  },
  "include": [
    "bin/**/*",
    "lib/**/*",
    "lambda/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "cdk.out",
    "dist"
  ]
}